{
  "name": "@casaub0n/tsbox",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript sandbox for me",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:casaub0n/casaub0n.git",
    "directory": "packages/tsbox"
  },
  "author": "casaub0n <netzach.yoshida@gmail.com> (https://github.com/casaub0n)",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.mts",
    "default": "./dist/index.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:ci": "pnpm test",
    "test:export": "vitest --reporter=html",
    "rmdist": "node scripts/rrm.ts",
    "build": "tsdown",
    "start:tsbox": "pnpm build && node dist/index.mjs",
    "lint": "oxlint",
    "type:check": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "typescript",
    "vitest",
    "tsdown"
  ],
  "dependencies": {
    "capnp-es": "catalog:",
    "consola": "catalog:",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "get-windows": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@casaub0n/eslint-base": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
