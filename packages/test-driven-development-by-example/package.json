{
  "name": "@casaub0n/test-driven-development-by-example",
  "version": "1.0.0",
  "private": true,
  "description": "test driven development by example for TypeScript",
  "license": "MIT",
  "repository": {
    "url": "git@github.com:casaub0n/casaub0n.git",
    "type": "git",
    "directory": "packages/test-driven-development-by-example"
  },
  "homepage": "https://github.com/casaub0n/casaub0n/tree/main/packages/test-driven-development-by-example#readme",
  "author": "casaub0n <netzach.yoshida@gmail.com> (https://github.com/casaub0n)",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.mts",
    "default": "./dist/index.mjs"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "type:check": "tsc --noEmit",
    "test": "tsx src/money.test.ts",
    "start": "tsx src/index.ts",
    "test:watch": "node --watch --no-warnings --import tsx src/money.test.ts",
    "test:ci": "pnpm test",
    "test:purenode": "pnpm build && pnpm node dist/test.mjs",
    "build": "tsdown",
    "test:report": "node --test --experimental-test-coverage --test-reporter=tap --test-reporter-destination=./dist/test-driven-development-by-example-report.tap ./dist/test.mjs && tap ./dist/test-driven-development-by-example-report.tap",
    "lint": "oxlint",
    "lint:turbo": "turbo lint"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "testing",
    "typescript",
    "node.js"
  ],
  "dependencies": {
    "consola": "catalog:"
  },
  "devDependencies": {
    "@casaub0n/eslint-base": "workspace:*",
    "@types/node": "catalog:",
    "eslint-node-test": "catalog:",
    "tap": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
