    "default": "./dist/index.mjs"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch src",
    "lint": "eslint src/**",
    "gendts": "node --import tsx src/generate-rules-dts.ts"
  },
  "files": [
    "./dist/index.mjs",
    "./dist/index.d.mts"
  ],
  "keywords": [
    "eslint",
    "typescript",
    "node.js",
